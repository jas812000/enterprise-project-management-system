<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Local Quality Gate Java Quality Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">

    <description>
        Java static analysis rules for the Local Quality Gate.

        Enforces PMD Best Practices, Error Prone, and selected
        Code Style rules while excluding overly restrictive
        declarations and constructor conventions.
    </description>

    <!-- Best Practices -->
    <rule ref="category/java/bestpractices.xml"/>

    <!-- Error Prone -->
    <rule ref="category/java/errorprone.xml"/>

    <!-- Code Style -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="MethodArgumentCouldBeFinal"/>
        <exclude name="LocalVariableCouldBeFinal"/>
        <exclude name="LocalVariableDeclarationShouldBeAtStartOfBlock"/>
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="LongVariable"/>
    </rule>

    <!-- Allow descriptive Java identifiers up to 30 characters. -->
    <rule ref="category/java/codestyle.xml/LongVariable">
        <properties>
            <property name="minimum" value="31"/>
        </properties>
    </rule>

</ruleset>
